# VIRALYTICS AI Configuration - Team Go-Gitters
# DEMO_MODE: When true, uses single-source-of-truth demo fixture (87% overall, 74% confidence)
DEMO_MODE=true

# GEMINI_API_KEY: Optional. For LLM-powered dynamic hook rewrites and video optimization recommendations.
# AI Studio automatically injects this at runtime if configured.
GEMINI_API_KEY=""

# TINYFISH_API_KEY: Optional. For live Trend Radar, Search, Fetch, and Research benchmarks.
# Falls back to seeded data/trends_cache.json if empty or offline.
TINYFISH_API_KEY=""

# PORT: Web and API port (default 3000)
PORT=3000
